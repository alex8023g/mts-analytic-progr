{
  "name": "mts-analytic-progr",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "backend:dev": "cd backend && .venv/bin/fastapi dev app/main.py",
    "backend:prod": "cd backend && .venv/bin/fastapi run app/main.py",
    "frontend:dev": "cd frontend && npm run dev",
    "frontend:build": "cd frontend && npm run build",
    "frontend:prod": "cd frontend && npm run start",
    "install:frontend": "cd frontend && npm install",
    "install:backend": "cd backend && python3 -m venv .venv && .venv/bin/pip install -r requirements.txt",
    "install:all": "npm run install:frontend && npm run install:backend",
    "db:create": "cd backend && .venv/bin/python -m scripts.create_db",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
